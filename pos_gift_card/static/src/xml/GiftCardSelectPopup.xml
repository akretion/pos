<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="GiftCardSelectPopup" owl="1">
        <div role="dialog" class="modal-dialog">
            <Draggable>
                <div class="popup popup-selection">
                    <header class="title drag-handle">
                        <t t-esc="props.title" />
                    </header>
                    <div class="selection scrollable-y">
                        <t t-if="props.list.length">
                            <span>Select from list:</span>
                            <t t-foreach="props.list" t-as="item" t-key="item.id">
                                <div class="selection-item" t-att-class="{ selected: item.isSelected }"
                                     t-on-click="selectItem(item.id)">
                                    <t t-esc="item.label" />
                                </div>
                            </t>
                        </t>
                        <label for="giftcardInput">Gift card code: </label>
                        <input id="giftcardInput" type="text" t-model="state.inputValue" t-ref="input" />

                    </div>
                    <footer class="footer">
                        <div class="button cancel" t-on-click="cancel">
                            <t t-esc="props.cancelText" />
                        </div>
                        <div class="button confirm" t-on-click="confirm">
                            <t t-esc="props.confirmText" />
                        </div>
                    </footer>
                </div>
            </Draggable>
        </div>
    </t>

</templates>
