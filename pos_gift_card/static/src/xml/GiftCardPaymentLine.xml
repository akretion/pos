<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="gift_card_pos.PaymentScreenPaymentLines" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('payment-name')]/t[@t-esc='line.payment_method.name']" position="after">
             <button
                t-on-click="giftcardconfigure"
                t-if="line.payment_method.name == 'Gift Card'"
            > Configure </button>
             <ul>
                <li class="info">
                 <t t-if="line.gift_card_selected_id" t-esc="line.gift_card_selected_id.name" />
                </li>
            </ul>
        </xpath>
    </t>
</templates>
