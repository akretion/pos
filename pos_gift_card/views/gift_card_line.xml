<odoo>
    <record model="ir.ui.view" id="gift_card_form_view">
        <field name="name">gift.card.line.form</field>
        <field name="model">gift.card.line</field>
        <field name="inherit_id" ref="gift_card.gift_card_line_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_ids']" position="before">
                <field name="pos_order_id"/>

            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="gift_card_line_tree_view">
        <field name="name">gift.card.line.tree</field>
        <field name="model">gift.card.line</field>
        <field name="inherit_id" ref="gift_card.gift_card_line_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_ids']" position="after">
                <field name="pos_order_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='payment_id']" position="after">
                <field name="pos_payment_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
