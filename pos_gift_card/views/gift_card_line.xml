<odoo>
   

    <record model="ir.ui.view" id="gift_card_line_tree_view">
        <field name="model">gift.card.line</field>
        <field name="inherit_id" ref="gift_card.gift_card_line_tree_view" />
        <field name="arch" type="xml">
            <field name="sale_order_ids" position="after">
                <field name="pos_order_ids" widget="many2many_tags" optional="show" />
            </field>
            <field name="payment_id" position="after">
                <field name="pos_payment_id" optional="hide" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="gift_card_line_form_view">
        <field name="model">gift.card.line</field>
        <field name="inherit_id" ref="gift_card.gift_card_line_form_view" />
        <field name="arch" type="xml">
            <field name="sale_order_ids" position="after">
                <field name="pos_order_ids" />
            </field>
            <field name="payment_id" position="after">
                <field name="pos_payment_id"/>
            </field>
        </field>
    </record>

</odoo>
