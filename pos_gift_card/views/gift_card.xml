<odoo>
    <record model="ir.ui.view" id="gift_card_form_view">
        <field name="model">gift.card</field>
        <field name="inherit_id" ref="gift_card.gift_card_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='sale_order_ids']" position="after">
                <field name="pos_order_ids" widget="many2many_tags" optional="hide" />
            </xpath>
            <xpath expr="//tree/field[@name='payment_id']" position="after">                
                <field name="pos_payment_id" optional="hide" />
            </xpath>
        </field>
    </record>


    <record model="ir.ui.view" id="gift_card_tree_view">
        <field name="name">gift.card.tree</field>
        <field name="model">gift.card</field>
        <field name="inherit_id" ref="gift_card.gift_card_tree_view" />
        <field name="arch" type="xml">
            <field name="sale_order_ids" position="after">
                <field name="pos_order_ids" widget="many2many_tags" optional="show"/>
            </field>
            <field name="payment_id" position="after">
                <field name="pos_payment_id" optional="show"/>
            </field>
        </field>
    </record>

    <menuitem
        id="menu_giftcard_config"
        action="gift_card.gift_card_action"
        parent="point_of_sale.pos_config_menu_catalog"
        name="Gift Cards"
        groups="sales_team.group_sale_manager"
        sequence="15"
    />

</odoo>
