<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_gift_card_payment_config_view_form" model="ir.ui.view">
        <field name="name">pos.config.form</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='payment_methods_new']" position="before">
                <div class="col-12 col-lg-6 o_setting_box" id="pos-coupon">
                    <div class="o_setting_left_pane">
                        <field name="use_gift_card_as_payment" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="use_gift_card_as_payment"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
