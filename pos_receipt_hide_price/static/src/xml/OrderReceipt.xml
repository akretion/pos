<templates id="template" xml:space="preserve">
  <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
    <xpath expr="//span" position="replace">
      <span t-if="!isHidePrice()" t-esc="env.pos.format_currency_no_symbol(line.price_display)" class="price_display pos-receipt-right-align"/>
    </xpath>
  </t>
</templates>
