<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_caisse_ap" model="ir.ui.view">
        <field name="name">pos.payment.method.form.caisse_ap</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <field name="use_payment_terminal" position="after">
                <field name="iot_device_id"
                       invisible="use_payment_terminal != 'caisse_ap'"
                       required="use_payment_terminal == 'caisse_ap'"/>
            </field>
        </field>
    </record>
</odoo>
